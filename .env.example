# Database Connection URL (Postgres)
DATABASE_URL=postgresql://kanadshield:password@localhost/kanadshield

# Ingestion Database URL (Elasticsearch)
ES_URL=http://localhost:9200

# Streaming Message Queue URL (Kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# JWT Cryptographic Signing Key (generate a strong key for production)
SECRET_KEY=generate-a-secure-secret-key-here

# Directory path where uploaded PCAPs are stored locally
PCAP_STORAGE=./pcap_storage
